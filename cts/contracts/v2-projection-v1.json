          "path": "$.children[1].children[7]",
          "span": { "startOffset": 73, "endOffset": 83, "startLine": 5, "startColumn": 55, "endLine": 5, "endColumn": 65 }
        }
      ],
      "source": "&ND v2\n\n# Heading\n\n[# section][@ #section | Go [* now]] [! note] [? why] [+ custom]\n",
      "expected": {
        "canonical": {
          "embedded": "# Heading\n\n[# section][@ #section | Go [* now]] [! note] [? why] [+ custom]\n",
          "standalone": "&ND v2\n\n# Heading\n\n[# section][@ #section | Go [* now]] [! note] [? why] [+ custom]\n"
        },
        "html": {
          "fragment": "<h1>Heading</h1>\n<p><span class=\"and-anchor\" id=\"section\" aria-hidden=\"true\"></span><a href=\"#section\">Go <strong>now</strong></a> <span class=\"and-admonition\">note</span> <span class=\"and-question\">why</span> <span class=\"and-consumer-tag\" data-value=\"custom\">custom</span></p>",
          "document": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>&amp;ND Document</title>\n</head>\n<body>\n<h1>Heading</h1>\n<p><span class=\"and-anchor\" id=\"section\" aria-hidden=\"true\"></span><a href=\"#section\">Go <strong>now</strong></a> <span class=\"and-admonition\">note</span> <span class=\"and-question\">why</span> <span class=\"and-consumer-tag\" data-value=\"custom\">custom</span></p>\n</body>\n</html>\n"
