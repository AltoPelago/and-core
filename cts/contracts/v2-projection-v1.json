        },
        {
          "cover": "inline.local_fragment_link",
          "path": "$.children[1].children[1]",
          "span": { "startOffset": 30, "endOffset": 55, "startLine": 5, "startColumn": 12, "endLine": 5, "endColumn": 37 }
        },
        {
