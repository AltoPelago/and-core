{
  "schemaVersion": "1",
  "id": "seed-blockquote-escaped-inline",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "> \\[* not strong]\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one blockquote block",
      "quoted paragraph contains plain text `[* not strong]`",
      "no strong inline node"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "blockquote",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "[* not strong]"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
