{
  "schemaVersion": "1",
  "id": "seed-blockquote-nested-list-needs-margin",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "> Quote intro\n>\n- Child item\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one blockquote block containing one paragraph child",
      "one top-level unordered list block",
      "the list is not nested in the blockquote because it does not begin at the blockquote's current block margin"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "blockquote",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Quote intro"
                }
              ]
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "Child item"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
