{
  "schemaVersion": "1",
  "id": "seed-blockquote-nested-list",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "> Quote intro\n>\n> - Child item\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one blockquote block",
      "blockquote contains one paragraph child followed by one nested unordered list child"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "blockquote",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Quote intro"
                }
              ]
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                {
                  "type": "list_item",
                  "children": [
                    {
                      "type": "paragraph",
                      "children": [
                        {
                          "type": "text",
                          "value": "Child item"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
