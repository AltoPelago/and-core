{
  "schemaVersion": "1",
  "id": "seed-budget-block-count-at-limit",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "options": {
    "budgets": {
      "maxBlockCount": 2
    }
  },
  "source": "One\n\nTwo\n",
  "expected": {
    "ok": true,
    "assertions": [
      "whole-document block-count budget is inclusive at the configured limit"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "One"
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Two"
            }
          ]
        }
      ]
    }
  }
}
