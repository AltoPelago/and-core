{
  "schemaVersion": "1",
  "id": "seed-budget-code-block-size-at-limit",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "options": {
    "budgets": {
      "maxBlockSize": 8
    }
  },
  "source": "```\n12345678\n```\n",
  "expected": {
    "ok": true,
    "assertions": [
      "raw code block payload budget is inclusive at the configured limit"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "code_block",
          "language": null,
          "ordered": false,
          "text": "12345678"
        }
      ]
    }
  }
}
