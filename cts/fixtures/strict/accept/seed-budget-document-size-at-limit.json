{
  "schemaVersion": "1",
  "id": "seed-budget-document-size-at-limit",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "options": {
    "budgets": {
      "maxDocumentSize": 6
    }
  },
  "source": "Hello\n",
  "expected": {
    "ok": true,
    "assertions": [
      "document-size budget is inclusive at the configured limit"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Hello"
            }
          ]
        }
      ]
    }
  }
}
