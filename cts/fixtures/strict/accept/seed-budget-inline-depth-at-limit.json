{
  "schemaVersion": "1",
  "id": "seed-budget-inline-depth-at-limit",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "options": {
    "budgets": {
      "maxInlineDepth": 2
    }
  },
  "source": "[* outer [* inner]]\n",
  "expected": {
    "ok": true,
    "assertions": [
      "inline nesting-depth budget is inclusive at the configured limit"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "strong",
              "children": [
                {
                  "type": "text",
                  "value": "outer "
                },
                {
                  "type": "strong",
                  "children": [
                    {
                      "type": "text",
                      "value": "inner"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
