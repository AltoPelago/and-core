{
  "schemaVersion": "1",
  "id": "seed-budget-nesting-depth-at-limit",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "options": {
    "budgets": {
      "maxNestingDepth": 1
    }
  },
  "source": "> Quote\n",
  "expected": {
    "ok": true,
    "assertions": [
      "block nesting-depth budget is inclusive at the configured limit"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "blockquote",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Quote"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
