{
  "schemaVersion": "1",
  "id": "seed-inline-escaped-pipe-in-link-target",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "[@ https://example.com/a\\|b | label]\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one link node",
      "target contains the literal pipe character `|`"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "link",
              "href": "https://example.com/a|b",
              "children": [
                {
                  "type": "text",
                  "value": "label"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
