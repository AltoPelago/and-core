{
  "schemaVersion": "1",
  "id": "seed-inline-nbsp",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "A[_]B\n",
  "expected": {
    "ok": true,
    "assertions": [
      "`[_]` is a non-breaking space inline node",
      "`[_]` is no longer reserved for cancelled task markers"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "A"
            },
            {
              "type": "nbsp"
            },
            {
              "type": "text",
              "value": "B"
            }
          ]
        }
      ]
    }
  }
}
