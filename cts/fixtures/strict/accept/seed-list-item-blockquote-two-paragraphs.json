                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "Parent"
                    }
                  ]
                },
                {
                  "type": "blockquote",
                  "children": [
                    {
                      "type": "paragraph",
                      "children": [
                        {
                          "type": "text",
                          "value": "First paragraph"
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "children": [
                        {
                          "type": "text",
                          "value": "Second paragraph"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
