    "document": {
      "type": "document",
      "children": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "Parent"
                    }
                  ]
                },
                {
                  "type": "table",
                  "rows": [
                    "| A | B |",
                    "| --- | --- |",
                    "| 1 | 2 |"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
