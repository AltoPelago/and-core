{
  "schemaVersion": "1",
  "id": "seed-list-item-table",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "- Parent\n\n  | A | B |\n  | --- | --- |\n  | 1 | 2 |\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one unordered list block",
      "first item contains one nested table block",
      "table has two columns and one body row"
