{
  "schemaVersion": "1",
  "id": "seed-ordered-list-after-blank-line",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "My number is\n\n1. a list item\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one paragraph block",
      "one ordered list block with one item"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "My number is"
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "a list item"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
