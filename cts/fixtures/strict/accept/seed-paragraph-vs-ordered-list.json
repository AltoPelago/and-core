{
  "schemaVersion": "1",
  "id": "seed-paragraph-vs-ordered-list",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "My number is\n1. not a list\n",
  "expected": {
    "ok": true,
    "assertions": [
      "one paragraph block",
      "paragraph contains two lines of text"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "My number is\n1. not a list"
            }
          ]
        }
      ]
    }
  }
}
