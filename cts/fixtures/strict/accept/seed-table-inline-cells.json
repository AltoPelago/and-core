    "assertions": [
      "one table block",
      "first body cell contains one strong inline node",
      "second body cell contains a literal pipe character"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "table",
          "header": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "Name"
                }
              ]
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Note"
                }
              ]
            }
          ],
          "rows": [
            [
              {
                "children": [
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "Ada"
                      }
                    ]
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "value": "escaped | pipe"
                  }
                ]
              }
            ]
          ]
        }
      ]
    }
  }
}
