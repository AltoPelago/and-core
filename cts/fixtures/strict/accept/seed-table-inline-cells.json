{
  "schemaVersion": "1",
  "id": "seed-table-inline-cells",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "| Name | Note |\n| --- | --- |\n| [* Ada] | escaped \\| pipe |\n",
  "expected": {
