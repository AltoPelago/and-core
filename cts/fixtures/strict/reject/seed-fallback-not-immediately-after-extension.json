  "id": "seed-fallback-not-immediately-after-extension",
  "specVersion": "&ND Core v1",
  "mode": "strict",
  "source": "+++chart/pie\napples: 30\n+++\n\nParagraph.\n\n+++fallback\nChart unavailable.\n+++\n",
  "expected": {
