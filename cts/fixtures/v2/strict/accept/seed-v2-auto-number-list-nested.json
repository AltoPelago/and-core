{
  "schemaVersion": "1",
  "id": "seed-v2-auto-number-list-nested",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\n- [n] parent\n  - [n] child\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 accepts immediate two-space auto-number-list nesting without a blank line",
      "nested auto-number lists remain first-class auto_number_list nodes"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "auto_number_list",
          "items": [
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [{ "type": "text", "value": "parent" }]
                },
                {
                  "type": "auto_number_list",
                  "items": [
                    {
                      "type": "list_item",
                      "children": [
                        {
                          "type": "paragraph",
                          "children": [{ "type": "text", "value": "child" }]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
