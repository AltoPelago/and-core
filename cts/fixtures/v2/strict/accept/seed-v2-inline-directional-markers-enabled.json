        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Go "
            },
            {
              "type": "directional_marker",
              "direction": "forward"
            },
            {
              "type": "text",
              "value": " then "
            },
            {
              "type": "directional_marker",
              "direction": "backward"
            },
            {
              "type": "text",
              "value": " return."
            }
          ]
        }
      ]
    }
  }
