{
  "schemaVersion": "1",
  "id": "seed-v2-inline-highlight-tag-enabled",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\nMark [= important] now.\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 strict mode accepts highlight-tag inline form",
      "highlight tag payload is preserved as rich inline children"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Mark "
            },
            {
              "type": "highlight_tag",
              "children": [
                {
                  "type": "text",
                  "value": "important"
                }
              ]
            },
            {
              "type": "text",
              "value": " now."
            }
          ]
        }
      ]
    }
  }
}
