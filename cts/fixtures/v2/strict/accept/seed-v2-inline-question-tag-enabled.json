{
  "schemaVersion": "1",
  "id": "seed-v2-inline-question-tag-enabled",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\nAsk [? why] now.\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 strict mode accepts question-tag inline form",
      "question tag content is trimmed and preserved as explicit node value"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Ask "
            },
            {
              "type": "question_tag",
              "value": "why"
            },
            {
              "type": "text",
              "value": " now."
            }
          ]
        }
      ]
    }
  }
}
