    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "This is "
            },
            {
              "type": "strike_tag",
              "value": "obsolete"
            },
            {
              "type": "text",
              "value": " now."
            }
          ]
        }
      ]
    }
  }
}
