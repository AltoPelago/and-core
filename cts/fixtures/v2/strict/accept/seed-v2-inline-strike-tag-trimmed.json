{
  "schemaVersion": "1",
  "id": "seed-v2-inline-strike-tag-trimmed",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\nThis is [-   old-value   ] now.\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 strict mode accepts strike tags with surrounding payload whitespace",
      "strike tag payload is interpreted after trim"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "This is "
            },
            {
              "type": "strike_tag",
              "children": [
                {
                  "type": "text",
                  "value": "old-value"
                }
              ]
            },
            {
              "type": "text",
              "value": " now."
            }
          ]
        }
      ]
    }
  }
}
