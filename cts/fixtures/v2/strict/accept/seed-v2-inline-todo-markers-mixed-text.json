{
  "schemaVersion": "1",
  "id": "seed-v2-inline-todo-markers-mixed-text",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\nTasks: [ ] alpha, [x] beta.\n",
  "expected": {
    "ok": true,
    "assertions": [
      "todo markers parse inline alongside plain text",
      "marker parsing remains local and deterministic"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Tasks: "
            },
            {
              "type": "todo_marker",
              "state": "unchecked"
            },
            {
              "type": "text",
              "value": " alpha, "
            },
            {
              "type": "todo_marker",
              "state": "checked"
            },
            {
              "type": "text",
              "value": " beta."
            }
          ]
        }
      ]
    }
  }
}
