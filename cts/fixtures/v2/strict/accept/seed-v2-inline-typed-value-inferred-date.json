{
  "schemaVersion": "1",
  "id": "seed-v2-inline-typed-value-inferred-date",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\n[: 2024-01-01]\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 typed-value shorthand infers the date datatype from an AEON date literal",
      "the shorthand produces the same typed value node as the explicit assignment"
