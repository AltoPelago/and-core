    "document": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "typed_value",
              "datatype": {
                "name": "date",
                "genericArgs": [],
                "clarifiers": []
              },
              "value": {
                "type": "DateLiteral",
                "value": "2024-01-01"
              }
            }
          ]
        }
      ]
    }
  }
}
