{
  "schemaVersion": "1",
  "id": "seed-v2-list-nested-without-blank-line",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\n- first\n- second\n  - third\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 accepts immediate two-space nested lists without a blank separator",
      "the relaxed v2 nesting rule applies to ordinary lists as well as contextual list kinds"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [{ "type": "text", "value": "first" }]
                }
              ]
            },
            {
              "type": "list_item",
              "children": [
                {
                  "type": "paragraph",
                  "children": [{ "type": "text", "value": "second" }]
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "type": "list_item",
                      "children": [
                        {
                          "type": "paragraph",
                          "children": [{ "type": "text", "value": "third" }]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
