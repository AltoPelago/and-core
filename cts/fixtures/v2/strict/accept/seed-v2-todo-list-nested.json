{
  "schemaVersion": "1",
  "id": "seed-v2-todo-list-nested",
  "specVersion": "&ND Core v2",
  "mode": "strict",
  "source": "&ND v2\n\n- [x] parser\n  - [ ] tests\n",
  "expected": {
    "ok": true,
    "assertions": [
      "v2 accepts immediate two-space todo-list nesting without a blank line",
      "nested todo lists remain first-class todo_list nodes"
    ],
    "document": {
      "type": "document",
      "children": [
        {
          "type": "todo_list",
          "items": [
            {
              "type": "todo_item",
              "state": "checked",
              "children": [
                {
                  "type": "paragraph",
                  "children": [{ "type": "text", "value": "parser" }]
                },
                {
                  "type": "todo_list",
                  "items": [
                    {
                      "type": "todo_item",
                      "state": "unchecked",
                      "children": [
                        {
                          "type": "paragraph",
                          "children": [{ "type": "text", "value": "tests" }]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
