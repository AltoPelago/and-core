{
  "name": "and-core",
  "private": true,
  "exports": {
    ".": "./index.mjs"
  },
  "bin": {
    "and": "./bin/and.mjs"
  },
  "scripts": {
    "test": "npm run precommit:check && npm run cts:run:reference && npm run cts:run:subset && npm run cts:run:example && npm run check:canonical-emitter && npm run check:html-renderer && npm run check:vscode && npm run vscode:package && npm run check:vscode-package && npm run check:public-api && npm run cli:smoke && npm run playground:check",
    "and": "node ./bin/and.mjs",
    "playground": "node scripts/serve-playground.mjs",
    "playground:check": "node scripts/check-playground.mjs",
    "vscode:package": "node scripts/package-vscode.mjs",
    "check:no-local-paths": "bash scripts/check-no-local-paths.sh",
    "check:spec-layout": "bash scripts/check-spec-layout.sh",
    "check:cts-fixtures": "bash scripts/check-cts-fixtures.sh",
    "check:cts-seed-coverage": "bash scripts/check-cts-seed-coverage.sh",
    "check:cts-v2-lane": "bash scripts/check-cts-v2-lane.sh",
    "check:aeon-inline-scalar-contract": "node scripts/check-aeon-inline-scalar-contract.mjs",
    "check:aeon-inline-scalar-drift": "node scripts/check-aeon-inline-scalar-drift.mjs",
    "check:v2-projection-contract": "node scripts/check-v2-projection-contract.mjs",
    "check:v2-guidance": "node scripts/check-v2-guidance.mjs",
    "check:reports": "node scripts/check-reports-fresh.mjs",
    "check:canonical-emitter": "node scripts/check-canonical-emitter.mjs",
    "check:html-renderer": "node scripts/check-html-renderer.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:vscode": "node scripts/check-vscode.mjs",
    "check:vscode-package": "node scripts/check-vscode-package.mjs",
    "html:report": "node scripts/check-html-renderer.mjs --out ./cts/reports/reference-html-report.json",
    "cli:smoke": "node scripts/check-cli.mjs",
    "canonical:report": "node scripts/check-canonical-emitter.mjs --out ./cts/reports/reference-canonical-report.json",
    "cts:run": "node scripts/run-cts.mjs",
    "cts:run:example": "node scripts/run-cts.mjs --adapter ./cts/examples/baseline-adapter.mjs",
    "cts:run:subset": "node scripts/run-cts.mjs --adapter ./implementations/reference-subset/adapter.mjs",
    "cts:run:reference": "node scripts/run-cts.mjs --adapter ./implementations/reference-parser/adapter.mjs",
    "cts:run:v2:proposal": "node scripts/run-cts-v2-proposal.mjs",
    "cts:report:example": "node scripts/run-cts.mjs --adapter ./cts/examples/baseline-adapter.mjs --json --quiet --out ./cts/reports/baseline-adapter-report.json",
    "cts:report:subset": "node scripts/run-cts.mjs --adapter ./implementations/reference-subset/adapter.mjs --json --quiet --out ./cts/reports/reference-subset-report.json",
    "cts:report:reference": "node scripts/run-cts.mjs --adapter ./implementations/reference-parser/adapter.mjs --json --quiet --out ./cts/reports/reference-parser-report.json",
    "cts:report:all": "npm run cts:report:reference && npm run cts:report:subset && npm run cts:report:example && npm run canonical:report && npm run html:report",
    "precommit:check": "bash scripts/pre-commit-check.sh && npm run check:public-api"
  }
}
