{
  "comments": {},
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^((  )*(> ?)?(- |\\d+\\. )|(#{1,6} )|(\\|.*\\|$)|(\\+\\+\\+[a-z][a-z0-9-]*(?:\\/[a-z][a-z0-9-]*)*(?:\\.v[0-9]+)?)|(`{3,4}[A-Za-z0-9_-]*)).*$",
    "decreaseIndentPattern": "^((  )*(> ?)?(`{3,4}|\\+\\+\\+))$"
  }
}
